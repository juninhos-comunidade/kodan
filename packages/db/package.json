{
  "name": "@kodan/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:backfill:attempts": "bun run ./src/attempt-session-backfill.ts",
    "db:backfill:attempts:apply": "bun run ./src/attempt-session-backfill.ts --apply",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:sqlite-to-neon": "bun run ./src/migrate-sqlite-to-neon.ts",
    "db:generate:challenges": "bun run ./src/generate-challenges-content.ts",
    "db:sync:challenges:index": "bun run ./src/sync-challenges-index.ts",
    "db:seed:challenges": "bun run ./src/seed-challenges.ts",
    "evaluation:validate-rubrics": "bun run ./src/validate-evaluation-rubrics.ts",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@kodan/content": "workspace:*",
    "@kodan/env": "workspace:*",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kodan/config": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "^22.13.14",
    "prisma": "^7.8.0",
    "typescript": "catalog:"
  }
}

model Challenge {
  id             String    @id @default(uuid())
  title          String
  language       String    @default("react")
  difficulty     String    // EASY, MEDIUM, HARD
  recommendedElo Int       @default(1200)
  code           String?   // Optional for conceptual and terminal-only challenges
  codeFileName   String?
  scenario       String?
  topic          String    @default("state-rendering")
  presentation   String    @default("code")
  intent         String    @default("diagnose")
  terminalJson   String?
  question       String    // Question to diagnose
  solution       String    // Senior solution template
  tags           String    // Comma-separated tags, e.g. "useEffect,stale-closure"
  promoted       Boolean   @default(true)
  evaluationRubricJson String?
  attempts       Attempt[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("challenge")
  @@index([language])
  @@index([language, topic])
  @@index([promoted])
}

enum AttemptSessionStatus {
  RETRY_AVAILABLE
  SOLVED
  ELO_EXHAUSTED
  REVEALED
}

model Attempt {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId  String
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userAnswer   String    // Answer typed by the user
  feedbackJson String    // JSON containing score, summary, strengths, blindspots, seniorSolution
  score        Float     // 0-10 score
  eloChange    Int       // ELO variation (+/-)
  attemptNumber Int      @default(1)
  sessionStatus AttemptSessionStatus @default(RETRY_AVAILABLE)
  activationCounted Boolean @default(false)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([challengeId])
  @@map("attempt")
}

model ProductEventAggregate {
  name             String
  scopeKey         String
  contextBucket    String
  day              DateTime  @db.Date
  count            Int       @default(0)
  updatedAt        DateTime  @updatedAt

  @@id([name, scopeKey, contextBucket, day])
  @@index([name, day])
  @@map("product_event_aggregate")
}

{
  "name": "kodan",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "sonner": "^2.0.5",
      "@prisma/client": "^7.8.0",
      "better-auth": "1.6.11",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "db:push": "bun run --filter @kodan/db db:push",
    "db:backfill:attempts": "bun run --filter @kodan/db db:backfill:attempts",
    "db:backfill:attempts:apply": "bun run --filter @kodan/db db:backfill:attempts:apply",
    "db:studio": "bun run --filter @kodan/db db:studio",
    "db:generate": "bun run --filter @kodan/db db:generate",
    "db:generate:challenges": "bun run --filter @kodan/db db:generate:challenges",
    "db:sync:challenges:index": "bun run --filter @kodan/db db:sync:challenges:index",
    "db:migrate": "bun run --filter @kodan/db db:migrate",
    "db:migrate:sqlite-to-neon": "bun run --filter @kodan/db db:migrate:sqlite-to-neon",
    "db:seed:challenges": "bun run --filter @kodan/db db:seed:challenges",
    "db:seed:challenges:reconcile": "bun run --filter @kodan/db db:seed:challenges:reconcile",
    "doctor": "react-doctor",
    "openapi:generate": "bun run ./scripts/generate-openapi.ts",
    "evaluation:benchmark": "bun run ./scripts/evaluation/benchmark.ts",
    "evaluation:check-types": "tsc --noEmit -p ./scripts/evaluation/tsconfig.json",
    "product-events:funnel": "bun run ./scripts/product-events/funnel.ts",
    "docs:dev": "bun run openapi:generate && bun run --filter docs dev",
    "docs:build": "bun run openapi:generate && bun run --filter docs build",
    "question-bank:generate": "bun run ./scripts/question-bank/generate.ts",
    "question-bank:validate": "bun run ./scripts/question-bank/validate.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@kodan/env": "workspace:*",
    "@radix-ui/react-label": "^2.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.10.0",
    "lucide-react": "^1.27.0",
    "react-hook-form": "^7.82.0",
    "resend": "^6.18.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@kodan/config": "workspace:*",
    "@types/node": "^22.13.14",
    "typescript": "catalog:",
    "react-doctor": "^0.2.6",
    "web": "workspace:*",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.3.4"
}
